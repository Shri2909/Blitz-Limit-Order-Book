# Build outputs
build/
build-xdp/
*.o
*.obj

# Generated benchmark/dataset artifacts
# WHY: dataset files are deterministic and regenerable via blitz_gen_dataset
#      given the same seed + config. Store seed/flags in datasets/manifest.txt
#      instead of committing the binary files themselves.
*.csv
results/
datasets/

# CMake cache
compile_commands.json
.cache/

# metrics/ -- generated visual-proof report and its scratch build outputs.
# WHY: regenerable in one command (./metrics/generate_metrics.sh) from the
#      current code and whatever machine runs it; committing a stale report
#      would silently drift from the code it claims to measure.
metrics/out/
metrics/bin/
